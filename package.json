{
  "name": "@riavzon/ai",
  "author": "Sergio contact@riavzon.com",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Zero-magic embeddable TypeScript agent runtime. Full control over your HTTP layer, database state, and raw OpenAI wire payloads. Scales from zero-config SQLite to multi-replica Postgres and Redis Streams with no external daemons and no hidden prompts.",
  "keywords": [
    "ai",
    "agents",
    "agentic",
    "agent-runtime",
    "llm",
    "openai",
    "tool-calling",
    "function-calling",
    "mcp",
    "model-context-protocol",
    "rag",
    "embeddings",
    "vector-search",
    "pgvector",
    "sqlite",
    "redis-streams",
    "workflow",
    "kysely",
    "typescript",
    "backend",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Sergo706/ai"
  },
  "homepage": "https://ai.riavzon.com",
  "bugs": {
    "url": "https://github.com/Sergo706/ai/issues"
  },
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.mts",
        "default": "./dist/main.mjs"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "prettier $(git diff --cached --name-only --diff-filter=ACMR | sed 's| |\\ |g') --write --ignore-unknown && git update-index --again",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npx vitest",
    "build": "tsdown",
    "docs": "typedoc --options ./typedoc.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@riavzon/utils": "^1.4.0",
    "agents": "^0.34.1",
    "kysely": "0.29.9",
    "pdf-parse": "2.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "ioredis": "6.0.0",
    "openai": "7.63.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=4.0.0",
    "@modelcontextprotocol/client": ">=2.0.0",
    "@pdf-lib/fontkit": ">=1.1.0",
    "@steipete/summarize-core": ">=0.26.0",
    "better-sqlite3": ">=13.0.0",
    "easy-currencies": ">=2.0.0",
    "exceljs": ">=4.4.0",
    "ioredis": ">=6.0.0",
    "mathjs": ">=15.0.0",
    "openai": ">=7.0.0",
    "pdf-lib": ">=1.17.0",
    "pg": ">=8.0.0",
    "sqlite-vec": ">=0.1.9"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@pdf-lib/fontkit": {
      "optional": true
    },
    "@steipete/summarize-core": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "easy-currencies": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mathjs": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    }
  }
}
